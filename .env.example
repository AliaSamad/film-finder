# Postgres connection string (matches docker-compose.yml)
DATABASE_URL=postgres://filmfinder:filmfinder@localhost:5432/filmfinder

# TMDB v4 "API Read Access Token" (Bearer token) from
# https://www.themoviedb.org/settings/api
TMDB_READ_TOKEN=

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=
